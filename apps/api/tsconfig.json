{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "incremental": true,
    // Must live inside outDir: nest-cli's `deleteOutDir` wipes dist/ but would
    // leave a root-level tsbuildinfo behind, so tsc would treat unchanged files
    // as already emitted and silently skip them, producing a broken build.
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true
  },
  // `prisma/` is intentionally excluded: seed.ts runs through tsx, and including
  // it would widen rootDir to the package root and emit dist/src/main.js.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
