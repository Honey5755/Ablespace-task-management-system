# Copy to .env — `npm run env` does this for you if .env is missing.

# PostgreSQL. Local default matches docker-compose.yml at the repo root.
# For a hosted database (Neon, Supabase, Railway) paste its connection string
# here and append ?sslmode=require.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pyramid?schema=public"

# Change this in any non-local environment.
JWT_SECRET="dev-only-secret-change-me"
JWT_EXPIRES_IN="30d"

PORT=4000

# Comma-separated list of allowed browser origins.
CORS_ORIGIN="http://localhost:3000"
